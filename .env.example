# Copy to .env.local and fill in.
MONGODB_URI=
MONGODB_DB=tfn
# At least 32 random characters. Generate with: openssl rand -base64 48
SESSION_SECRET=
# The default super admin created by `pnpm seed`. The password is temporary:
# the first sign-in asks for a new one.
SEED_ADMIN_EMAIL=admin@tfnetwork.org
SEED_ADMIN_PASSWORD=
# The real community links. They are only shown to people after they register.
WHATSAPP_CHANNEL_URL=
TELEGRAM_CHANNEL_URL=
TELEGRAM_HELP_URL=
